{
  "manifest_version": 3,
  "name": "Window Fullscreen",
  "version": "0.1.2",
  "description": "Fullscreen videos to the browser window instead of the OS display.",
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ]
}
